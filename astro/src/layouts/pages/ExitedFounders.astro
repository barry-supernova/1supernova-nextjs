                height="9"
                fill="#FFFFFF"></rect><circle
                cx="6.500"
                cy="6.200"
                r="1.800"
                fill="#FFFFFF"></circle><path
                d="M10.500 9.500h2.900v1.300c.500-.900 1.600-1.600 3.100-1.600 2.700 0 3.500 1.700 3.500 4.300v5h-3v-4.500c0-1.200-.300-2.100-1.500-2.100s-2 .800-2 2.200v4.400h-3z"
                fill="#FFFFFF"></path></svg
            ></a
          ></div
        ></article
      >
      <article style="display: flex; flex-direction: column; gap: 8px"
        ><img
          loading="lazy"
          decoding="async"
          class="sn-face"
