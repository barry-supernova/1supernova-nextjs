                fill="#FFFFFF"></path></svg
            ></a
          ></div
        ></article
      >
      <article style="display: flex; flex-direction: column; gap: 8px"
        ><img
          loading="lazy"
          decoding="async"
          class="sn-face"
          src="/assets/aly-orady-24ab59751d9c.png"
          alt="Aly Orady"
          style="aspect-ratio: 1 / 1; width: 100%; object-fit: cover; object-position: center top; border-radius: 6px; display: block"
        /><div
          style="flex: 1; background: #EFE8D8; border-radius: 4px; padding: 12px 14px 14px; display: flex; flex-direction: column; gap: 6px"
          ><span
            class="[font-family:'IBM_Plex_Mono',ui-monospace,Menlo,monospace] font-medium text-[13px] tracking-[0.12em] uppercase"
            >Aly Orady</span
          ><span
            class="[font-family:'IBM_Plex_Mono',ui-monospace,Menlo,monospace] text-[12px] leading-[1.45] tracking-[0.1em] uppercase text-[#5E584C]"
            >Founder &amp; former CEO, Tonal</span
          ><a
            class="self-start mt-auto"
            href="https://www.linkedin.com/in/aorady"
            target="_blank"
            rel="noopener"
            aria-label="Aly Orady on LinkedIn"
            ><svg
              class="block"
              aria-hidden="true"
              viewBox="0 0 24 24"
              width="20"
              height="20"
              ><rect width="24" height="24" rx="4" fill="#14120E"></rect><rect
                x="5"
                y="9.500"
                width="3"
                height="9"
                fill="#FFFFFF"></rect><circle
                cx="6.500"
                cy="6.200"
                r="1.800"
                fill="#FFFFFF"></circle><path
                d="M10.500 9.500h2.900v1.300c.500-.900 1.600-1.600 3.100-1.600 2.700 0 3.500 1.700 3.500 4.300v5h-3v-4.500c0-1.200-.300-2.100-1.500-2.100s-2 .800-2 2.200v4.400h-3z"
                fill="#FFFFFF"></path></svg
            ></a
          ></div
        ></article
      >
      <article style="display: flex; flex-direction: column; gap: 8px"
        ><img
          loading="lazy"
          decoding="async"
          class="sn-face"
          src="/assets/dave-asprey-d96da04f2280.png"
          alt="Dave Asprey"
          style="aspect-ratio: 1 / 1; width: 100%; object-fit: cover; object-position: center top; border-radius: 6px; display: block"
        /><div
          style="flex: 1; background: #EFE8D8; border-radius: 4px; padding: 12px 14px 14px; display: flex; flex-direction: column; gap: 6px"
          ><span
            class="[font-family:'IBM_Plex_Mono',ui-monospace,Menlo,monospace] font-medium text-[13px] tracking-[0.12em] uppercase"
            >Dave Asprey</span
          ><span
            class="[font-family:'IBM_Plex_Mono',ui-monospace,Menlo,monospace] text-[12px] leading-[1.45] tracking-[0.1em] uppercase text-[#5E584C]"
            >Founder, Bulletproof. Co-founder, Basis (acquired by Intel)</span
          ><a
            class="self-start mt-auto"
            href="https://www.linkedin.com/in/asprey/"
