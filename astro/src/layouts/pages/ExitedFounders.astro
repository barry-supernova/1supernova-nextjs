      <div class="flex flex-col gap-[18px]">
        <span
          class="[font-family:'IBM_Plex_Mono',ui-monospace,Menlo,monospace] text-[12px] tracking-[0.12em] uppercase text-[#5E584C]"
          >JOIN US&nbsp;</span
