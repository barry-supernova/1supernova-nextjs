---
import type { CollectionEntry } from "astro:content";
import Faq from "../components/Faq.astro";
import "../../styles/pages/growth-stage-ceos.css";

interface Props {
  content: CollectionEntry<"pages">["data"];
}

const { content } = Astro.props;
const sectionGutter = "px-[clamp(1rem,4vw,2rem)]";
const sectionSpace = "py-[clamp(3.5rem,9vw,6.5rem)]";
const wideSectionSpace = "py-[clamp(3.5rem,10vw,7rem)]";
---

<section class="sn-hero text-cream max-[720px]:[background-position:58%_42%]">
  <img
    loading="lazy"
    decoding="async"
    class="sn-burst sn-burst-l w-[min(30vw,420px)]"
    src="/assets/star-lines-4dde23efecf3.png"
    alt=""
    aria-hidden="true"
  />
  <img
    loading="lazy"
    decoding="async"
    class="sn-burst sn-burst-r w-[min(30vw,420px)]"
    src="/assets/star-lines-4dde23efecf3.png"
    alt=""
    aria-hidden="true"
  />

  <div class:list={[sectionGutter, "sn-growth-hero-inner flex items-center box-border min-h-[clamp(34rem,64vw,48.75rem)] pt-[clamp(4rem,10.5vw,8rem)] pb-[clamp(4.5rem,11vw,8.5rem)] max-[960px]:bg-[linear-gradient(90deg,#14120ef2,#14120edb_60%,#14120e66)] max-[640px]:min-h-0"]}>
    <div class="max-w-[1160px] w-full mx-auto my-0 relative" style="z-index: 1">
      <div class="max-w-[720px] flex flex-col gap-[clamp(18px,3vw,28px)]">
        <p
          class="m-0 text-[14px] font-semibold tracking-[0.08em] uppercase text-[#F5C400]"
          >{content.hero.eyebrow}</p
        >
        <h1
          class="m-0 [font-family:'Space_Grotesk',system-ui,sans-serif] font-semibold text-[clamp(36px,5vw,64px)] leading-[1.04] tracking-[-0.03em] text-balance"
          >{content.hero.title}</h1
        >
        <p class="m-0 text-[clamp(17px,2.4vw,21px)] leading-[1.5] text-[#E6DFCF]"
          >{content.hero.description}</p
        >
        {
          content.hero.cta && (
            <div
              class="flex flex-wrap items-center gap-x-6 gap-y-4 mt-[8px] max-[640px]:flex-col max-[640px]:items-start"
            >
              <a
                href={content.hero.cta.href}
                style="background: #F5C400; color: #14120E; text-decoration: none; font-weight: 600; font-size: 17px; padding: 17px 28px; border-radius: 6px"
              >
                {content.hero.cta.label}
              </a>
              {content.hero.cta.note && (
                <span class="text-[#FAF5EA] text-[17px]">
                  {content.hero.cta.note}
                </span>
              )}
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>

<section
  class:list={[sectionGutter, sectionSpace]}
  style="background: #FFFFFF; color: #14120E; border-bottom: 1px solid #E3DCCB"
>
  <div
    class="max-w-[1160px] mx-auto my-0 grid items-start grid-cols-[repeat(auto-fit,minmax(min(420px,100%),1fr))] gap-y-[40px] gap-x-[64px]"
  >
    <div class="flex flex-col gap-[28px]"
      ><h2
        class="m-0 [font-family:'Space_Grotesk',system-ui,sans-serif] font-semibold text-[clamp(36px,4.4vw,56px)] leading-[1.05] tracking-[-0.03em] text-[#14120E]"
        >Exited founders just get it. We're your unfair advantage.</h2
      >
      <div class="flex flex-wrap items-center" style="gap: 10px 16px"
        ><img
          class="h-[56px] w-auto block"
          loading="lazy"
          decoding="async"
          src="/assets/founder-avatars-1d615053384a.png"
          alt="Four exited founders from the Supernova network"
        /><span
          class="[font-family:'Space_Grotesk',system-ui,sans-serif] font-semibold text-[15px] tracking-[0.06em] uppercase"
          >250+ exited founders. Your unfair advantage.</span
        ></div
      >
      <div class="flex flex-col gap-[10px] mt-[12px]"
        ><span class="text-[16px] text-[#5E584C]" style="font-style: italic"
          >Why you need us&nbsp;</span
        ><div class="sn-why [&_b]:text-[clamp(3.25rem,7vw,4.5rem)] [&_span]:text-[clamp(1.0625rem,2.5vw,1.25rem)]"
          ><div class="sn-why-i sn-why-first" style="animation-delay: 0s"
            ><b class="text-[#2F8FE0]">88%</b><span
              >of VC-backed founders receive $0 at exit</span
            ><a
              href="https://www.econ.uzh.ch/en/people/faculty/scheuer/research.html"
              target="_blank"
              rel="noopener">Source: Wharton and University of Zurich, 2026</a
            ></div
          ><div class="sn-why-i" style="animation-delay: 3s"
            ><b class="text-[#1FA9B5]">&lt;20%</b><span
              >is what founders own by Series C</span
            ><a
              href="https://carta.com/data/founder-ownership-2026/"
              target="_blank"
              rel="noopener">Source: Carta, 2026</a
            ></div
          ><div class="sn-why-i" style="animation-delay: 6s"
            ><b class="text-[#D9A400]">50%</b><span
              >of founding CEOs are fired or forced out</span
            ><a
              href="https://hbr.org/2008/02/the-founders-dilemma"
              target="_blank"
              rel="noopener">Source: Noam Wasserman, HBR</a
            ></div
          ><div class="sn-why-i" style="animation-delay: 9s"
            ><b class="text-[#E0685E]">&lt;1%</b><span
              >of entrepreneurs exit</span
            ></div
          ><div class="sn-why-i" style="animation-delay: 12s"
            ><b class="text-[#A14FBF]">70%</b><span
              >of VC-backed startups fail</span
            ><a
              href="https://www.fastcompany.com/3003827/why-most-venture-backed-companies-fail"
              target="_blank"
              rel="noopener">Source: Shikhar Ghosh, HBS</a
            ></div
          ><div class="sn-why-i" style="animation-delay: 15s"
            ><b class="text-[#2F8FE0]">9%</b><span
              >of Series A companies make it to Series B</span
            ><a
              href="https://angelcapitalassociation.org/blog/getting-from-series-a-to-series-b-is-a-tall-task/"
              target="_blank"
              rel="noopener">Source: Carta, 2024</a
            ></div
          ><div class="sn-why-i" style="animation-delay: 18s"
            ><b class="text-[#1FA9B5]">83%</b><span
              >of founders live with chronic stress</span
            ><a
              href="https://sifted.eu/articles/founders-mental-health-2025"
              target="_blank"
              rel="noopener">Source: Sifted, 2025</a
            ></div
          ><div class="sn-why-i" style="animation-delay: 21s"
            ><b class="text-[#D9A400]">72%</b><span
              >of founders struggle with their mental health</span
            ><a
              href="https://www.startupsnapshot.com/research/the-untold-toll-the-impact-of-stress-on-the-well-being-of-startup-founders-and-ceos/"
              target="_blank"
              rel="noopener">Source: Startup Snapshot, 2023</a
            ></div
          ><div class="sn-why-i" style="animation-delay: 24s"
            ><b class="text-[#E0685E]">50%</b><span
              >of founders experience insomnia</span
            ><a
              href="https://sifted.eu/articles/founders-mental-health-2025"
              target="_blank"
              rel="noopener">Source: Sifted, 2025</a
            ></div
          ><div class="sn-why-i" style="animation-delay: 27s"
            ><b class="text-[#A14FBF]">70%</b><span
              >of unicorns are built by repeat founders</span
            ><a
              href="https://alitamaseb.medium.com/land-of-the-super-founders-a-data-driven-approach-to-uncover-the-secrets-of-billion-dollar-a69ebe3f0f45"
              target="_blank"
              rel="noopener">Source: Ali Tamaseb, Super Founders</a
            ></div
          ><div class="sn-why-i" style="animation-delay: 30s"
            ><b class="text-[#2F8FE0]">75%</b><span
              >of founders regret selling</span
            ><a
              href="https://exit-planning-institute.org/hubfs/Member%20Center%20Resources/2023%20National%20State%20of%20Owner%20Readiness%20Report.pdf"
              target="_blank"
              rel="noopener">Source: Exit Planning Institute, 2023</a
            ></div
          ><div class="sn-why-i" style="animation-delay: 33s"
            ><b class="text-[#1FA9B5]">93%</b><span
              >of VCs have never built a company</span
            ><a
              href="https://www.nber.org/system/files/working_papers/w29907/w29907.pdf"
              target="_blank"
              rel="noopener">Source: Gompers and Mukharlyamov, NBER, 2022</a
            ></div
          ></div
        ></div
      >
    </div>
    <div class="flex flex-col gap-[20px] text-[18px] text-[#3A362D]">
      <p class="m-0"
        >Scaling is a game of high-stakes decisions. Companies fail because the
        wrong choices compound at inflection points.</p
      >
      <p class="m-0"
        >That's why exited founders matter. Your board has opinions. Your
        investors have a position. Neither has done your job. We have.</p
      >
      <p class="m-0"
        >At Supernova, founders gain operators, not spectators. We embed and
        activate to accelerate critical milestones. We get in the game with you.</p
      >
      <p
        style="margin: 4px 0; padding: 4px 0 4px 20px; border-left: 4px solid #F5C400; font-weight: 600; font-size: 19px; line-height: 1.5; color: #14120E"
        ><span class="block mb-[12px]"
          >You're borrowing the relationships and <span
            style="background: linear-gradient(transparent 58%, #F5C400 58%); padding: 0 2px"
            >judgment</span
          > from founders who've already paid the tuition, so you don't have to.</span
        ><span
          >We lived the consequences of hyper-growth, near-death quarters, board
          pressure, and exits. Now we pay it forward. Supernova gives you the
          rarest resource:
        </span><span
          style="background: linear-gradient(transparent 58%, #F5C400 58%); padding: 0 2px"
          >wisdom</span
        ><span>, when it matters most.</span></p
      >
      <p class="m-0"
        >The next generation of iconic companies will be built by leaders
        evolving as fast as the markets around them and collaborating with
        relationships that bring an unfair advantage.<br /><br />Time to get to
        work.</p
      >
    </div>
  </div>
</section>

<section class:list={[sectionGutter, sectionSpace]}>
  <div
    class="max-w-[1160px] mx-auto my-0 grid items-center grid-cols-[repeat(auto-fit,minmax(min(420px,100%),1fr))] gap-y-[40px] gap-x-[64px]"
  >
    <div class="flex flex-col gap-[16px]">
      <h2
        class="m-0 [font-family:'Space_Grotesk',system-ui,sans-serif] font-semibold text-[44px] leading-[1.08] tracking-[-0.02em]"
        >Who we work with.</h2
      >
    </div>
    <ul
      style="margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column"
    >
      <li
        style="display: flex; gap: 20px; padding: 18px 0; border-top: 1px solid #E3DCCB"
        ><span class="font-semibold min-w-[110px]">Stage</span><span
          class="text-[#3A362D]">Bootstrapped, or Series A to C</span
        ></li
      >
      <li
        style="display: flex; gap: 20px; padding: 18px 0; border-top: 1px solid #E3DCCB"
        ><span class="font-semibold min-w-[110px]">Traction</span><span
          class="text-[#3A362D]">$5M-30M+ in revenue and scaling up</span
        ></li
      >
      <li
        style="display: flex; gap: 20px; padding: 18px 0; border-top: 1px solid #E3DCCB; border-bottom: 1px solid #E3DCCB"
        ><span class="font-semibold min-w-[110px]">Founder</span><span
          class="text-[#3A362D]"
          >Still the CEO, and open to coaching. No know-it-alls.</span
        ></li
      >
      <li
        style="display: flex; gap: 20px; padding: 18px 0; border-bottom: 1px solid #E3DCCB"
        ><span class="font-semibold min-w-[110px]">Moment</span><span
          class="text-[#3A362D]"
          >A high-stakes decision in the next 6 to 12 months: a raise, a key
          hire, a new business model or an exit</span
        ></li
      >
      <li
        style="display: flex; gap: 20px; padding: 18px 0; border-bottom: 1px solid #E3DCCB"
        ><span class="font-semibold min-w-[110px]">Commitment</span><span
          class="text-[#3A362D]"
          >Ready to compensate exited founders with equity or fees</span
        ></li
      >
      <li
        style="display: flex; gap: 20px; padding: 18px 0; border-bottom: 1px solid #E3DCCB"
        ><span class="font-semibold min-w-[110px]">Team</span><span
          class="text-[#3A362D]"
          >A leadership team that will work with exited founders</span
        ></li
      >
      <li
        style="display: flex; gap: 20px; padding: 18px 0; border-bottom: 1px solid #E3DCCB"
        ><span class="font-semibold min-w-[110px]">Mission</span><span
          class="text-[#3A362D]"
          >Building something that makes the world better</span
        ></li
      >
    </ul>
  </div>
</section>

<section class:list={[sectionGutter, sectionSpace]} style="background: #000000; color: #FAF5EA">
  <div
    class="max-w-[1160px] mx-auto my-0 grid items-center grid-cols-[repeat(auto-fit,minmax(min(420px,100%),1fr))] gap-y-[48px] gap-x-[72px]"
  >
    <div class="flex flex-col gap-[24px]">
      <span
        class="text-[14px] font-semibold tracking-[0.08em] uppercase text-[#F5C400]"
        >HOW IT WORKS</span
      >
      <h2
        class="m-0 [font-family:'Space_Grotesk',system-ui,sans-serif] font-semibold text-[clamp(36px,4.4vw,56px)] leading-[1.05] tracking-[-0.03em]"
        >Matched with exited founders in minutes.</h2
      >
      <p class="m-0 text-[19px] text-[#E6DFCF]"
        >Our north star is time. So we built NOVA AI. Tell NOVA your biggest
        challenge. NOVA finds the exited founders who have already solved it.</p
      >
      <ol
        class="m-0 mt-2 p-0 list-none grid grid-cols-[repeat(auto-fit,minmax(min(110px,100%),1fr))] gap-x-5 gap-y-4"
      >
        <li
          style="display: flex; flex-direction: column; gap: 4px; border-top: 2px solid #F5C400; padding-top: 12px"
          ><span class="text-[13px] font-semibold text-[#F5C400]">01</span><span
            class="[font-family:'Space_Grotesk',system-ui,sans-serif] font-semibold text-[19px] leading-[1.2]"
            >Match in minutes</span
          ></li
        >
        <li
          style="display: flex; flex-direction: column; gap: 4px; border-top: 2px solid #F5C400; padding-top: 12px"
          ><span class="text-[13px] font-semibold text-[#F5C400]">02</span><span
            class="[font-family:'Space_Grotesk',system-ui,sans-serif] font-semibold text-[19px] leading-[1.2]"
            >Approve who you meet</span
          ></li
        >
        <li
          style="display: flex; flex-direction: column; gap: 4px; border-top: 2px solid #F5C400; padding-top: 12px"
          ><span class="text-[13px] font-semibold text-[#F5C400]">03</span><span
            class="[font-family:'Space_Grotesk',system-ui,sans-serif] font-semibold text-[19px] leading-[1.2]"
            >Get on the phone</span
          ></li
        >
        <li
          style="display: flex; flex-direction: column; gap: 4px; border-top: 2px solid #F5C400; padding-top: 12px"
          ><span class="text-[13px] font-semibold text-[#F5C400]">04</span><span
            class="[font-family:'Space_Grotesk',system-ui,sans-serif] font-semibold text-[19px] leading-[1.2]"
            >Get to work</span
          ></li
        >
      </ol>
      <a
        href="https://nova.1supernova.com/#/apply-with-ai"
        style="align-self: flex-start; margin-top: 8px; background: #F5C400; color: #14120E; text-decoration: none; font-weight: 600; font-size: 17px; padding: 17px 28px; border-radius: 6px"
        >Get matched in minutes →</a
      >
      <p class="m-0 text-[14px] leading-[1.5] text-[#CFC7B6]"
        >Your data stays private. Supernova only shares it with the exited
        founders you select, so they are briefed before they speak with you.</p
      >
    </div>
    <img
      loading="lazy"
      decoding="async"
      src="/assets/nova-star-bc4e9cecd250.jpg"
      alt="NOVA, the Supernova AI guide, a glowing line-drawn star. Capital, exited founders, and a scorecard in minutes."
      style="width: 100%; max-width: 560px; height: auto; border-radius: 16px; display: block; justify-self: center"
    />
  </div>
</section>

<section
  class:list={[sectionGutter, "py-[clamp(4rem,12vw,9.5rem)] text-cream"]}
  style="background: linear-gradient(rgba(10, 9, 13, 0.76), rgba(10, 9, 13, 0.76)), #0A090D url(/assets/team-call-009bbac21e68.jpg) center / cover no-repeat"
>
  <div
    class="max-w-[860px] mx-auto my-0 flex flex-col items-center text-center gap-[20px]"
  >
    <span
      class="[font-family:'IBM_Plex_Mono',ui-monospace,Menlo,monospace] text-[13px] tracking-[0.24em] uppercase text-[#F5C400]"
      >SUPERNOVA IN ACTION</span
    >
    <h2
      class="m-0 [font-family:'Space_Grotesk',system-ui,sans-serif] font-semibold text-[clamp(36px,4.4vw,56px)] leading-[1.05] tracking-[-0.03em] text-balance"
      >This is what building together looks like.</h2
    >
    <p class="m-0 text-[19px] text-[#E6DFCF]"
      >A growth-stage company's leadership team in a working session with
      their Supernova exited founders.</p
    >
  </div>
</section>

<section class:list={[sectionGutter, sectionSpace]}>
  <div class="max-w-[1160px] mx-auto my-0 flex flex-col gap-[20px]">
    <div class="flex flex-col gap-[14px] mb-[24px]">
      <h2
        class="m-0 [font-family:'Space_Grotesk',system-ui,sans-serif] font-semibold text-[44px] leading-[1.08] tracking-[-0.02em]"
        >We show up at the inflection points where failure is not an option.</h2
      >
      <p class="m-0 text-[18px] text-[#3A362D]"
        >Five moments where a mistake is expensive and avoidable. Here is what
        happened when we showed up.</p
      >
    </div>
    <div class="sn-row grid-cols-[repeat(auto-fit,minmax(min(28rem,100%),1fr))]">
      <div class="sn-mo [--sn-card-padding:clamp(1rem,3vw,2rem)] p-(--sn-card-padding)"
        ><b>01</b><h3>Scaling to oversized outcomes</h3><b>The moment</b><p
          >Revenue is growing faster than your experience, and decisions are
          getting harder to reverse.</p
        ><p class="sn-help"
          >We put a founder beside you who scaled through the same jump, so you
          make the big calls once.</p
        ><div class="sn-voice gap-[clamp(0.75rem,2vw,1.125rem)] pt-[clamp(0.875rem,3vw,1.75rem)] [&>img]:h-[clamp(7.5rem,18vw,12.5rem)] max-[640px]:[&>img]:h-[clamp(5.5rem,20vw,9.5rem)] max-[640px]:[&>img]:max-w-[35%]"
          ><img
            loading="lazy"
            decoding="async"
            src="/assets/ashley-black-7dcc7e0f6f93.png"
            alt="Ashley Black, Founder of Ashley Black"
          /><blockquote
            >"It's been hard to find real partners who I trust. Supernova's
            exited founders just get it."<cite
              >Ashley Black, Founder and CEO</cite
            ></blockquote
          ></div
        ></div
      >
      <div class="sn-case p-[clamp(1rem,3vw,2rem)]"
        ><img
          class="h-[52px]"
          loading="lazy"
          decoding="async"
          src="/assets/ashley-logo-ab15e4d2b779.png"
          alt="Ashley Black"
        /><small>Case study · Ashley Black</small><h4
          >$200M+ in lifetime sales. Now it's time to reach mass markets and
          impact more lives.</h4
        ><p
          >Direct-to-consumer fascia care tools, and NeXcia, the company's first
          motorized device. Founder-led.</p
        ><p
          ><strong>The challenge</strong>Take a consumer device down a
          regulatory and clinical path nobody on the team had run before.</p
        ><p
          ><strong>The Supernova advantage</strong>A precise match. A four-time
          exited founder with medtech experience and university research ties,
          found for this one problem.</p
        ><p
          ><strong>The impact</strong>A regulatory roadmap and a product data
          plan for NeXcia, built by an exited founder working inside the team
          within five months.</p
        ></div
      >
    </div>
    <div class="sn-row grid-cols-[repeat(auto-fit,minmax(min(28rem,100%),1fr))]">
      <div class="sn-mo [--sn-card-padding:clamp(1rem,3vw,2rem)] p-(--sn-card-padding)"
        ><b>02</b><h3>Leveling up your leadership team</h3><b>The moment</b><p
          >Every executive is running a function bigger than any they have run
          before, and you can no longer coach each of them yourself.</p
        ><p class="sn-help"
          >We put an exited founder or operator beside each executive, working
          on that function's priorities.</p
        ></div
      >
      <div class="sn-case p-[clamp(1rem,3vw,2rem)]"
        ><img
          loading="lazy"
          decoding="async"
          src="/assets/baubap-logo-white-818f3ac2ba76.png"
          alt="Baubap"
        /><small>Case study · Baubap</small><h4
          >Every executive got a mentor who had done their job at scale.</h4
        ><p
          >App-based microloans for people in Mexico who are shut out of
          traditional banking. A Y Combinator company.</p
        ><p
          ><strong>The challenge</strong>Skill up the whole leadership team at
          once, beyond the CEO.</p
        ><p
          ><strong>The Supernova advantage</strong>Depth of network. Enough
          exited founders and operators to match six functions at the same time,
          with Baubap's own team choosing the lineup.</p
        ><p
          ><strong>The impact</strong>Six executives, each working with an
          exited founder or operator on fundraising, engineering, product,
          marketing, people or risk. The team also left with a fundraising plan
          and investor introductions.</p
        ></div
      >
    </div>
    <div class="sn-row grid-cols-[repeat(auto-fit,minmax(min(28rem,100%),1fr))]">
      <div class="sn-mo [--sn-card-padding:clamp(1rem,3vw,2rem)] p-(--sn-card-padding)"
        ><b>03</b><h3>Filling a key seat without a search</h3><b>The moment</b
        ><p
          >You need a proven executive now, and a hire that looks right on paper
          and fails in practice costs you a year.</p
        ><p class="sn-help"
          >Exited founders you already trust step in, each working in a zone of
          genius.</p
        ><div class="sn-voice gap-[clamp(0.75rem,2vw,1.125rem)] pt-[clamp(0.875rem,3vw,1.75rem)] [&>img]:h-[clamp(7.5rem,18vw,12.5rem)] max-[640px]:[&>img]:h-[clamp(5.5rem,20vw,9.5rem)] max-[640px]:[&>img]:max-w-[35%]"
          ><img
            loading="lazy"
            decoding="async"
            src="/assets/leo-rastogi-30b74ea4dfad.png"
            alt="Dr. Leo Rastogi, Founder of SoulSpring"
          /><blockquote
            >“I have built and exited three companies, so I know what the right
            people are worth. I needed a CMO and help on the raise, from people
            I trusted. Supernova had them, and they did the work.”<cite
              >Dr. Leo Rastogi, Founder, SoulSpring</cite
            ></blockquote
          ></div
        ></div
