---
import type { CollectionEntry } from "astro:content";
import Faq from "../components/Faq.astro";
import "../../styles/pages/home.css";

interface Props {
  content: CollectionEntry<"pages">["data"];
}

const { content } = Astro.props;
const narrowActionLayout =
  "max-[420px]:w-full max-[420px]:flex-col max-[420px]:[&>a]:self-stretch max-[420px]:[&>a]:text-center";
---

<section
  class="sn-hero box-border flex items-center px-5 pt-[clamp(56px,12vw,76px)] pb-[clamp(64px,15vw,84px)]
    text-cream max-[640px]:[background-position:center,58%_center] min-[641px]:min-h-[min(660px,100svh)]
    min-[641px]:px-8 min-[641px]:py-[clamp(72px,11vw,112px)] min-[1025px]:min-h-[780px]
    min-[1025px]:pt-32 min-[1025px]:pb-34"
>
  <div class="max-w-[1160px] w-full mx-auto my-0 relative" style="z-index: 1">
    <div class="max-w-[720px] flex flex-col gap-[clamp(20px,4.5vw,28px)]">
      <p
        class="m-0 text-[14px] font-semibold tracking-[0.08em] uppercase text-[#F5C400]"
        >{content.hero.eyebrow}</p
      >
      <h1
        class="m-0 [font-family:'Space_Grotesk',system-ui,sans-serif] font-semibold text-[clamp(38px,5.2vw,68px)] leading-[1.02] tracking-[-0.03em] whitespace-pre-line text-balance"
        >{content.hero.title}</h1
      >
      <p class="m-0 text-[clamp(17px,3.5vw,21px)] leading-[1.5] text-[#E6DFCF]"
        >{content.hero.description}</p
      >
      {
        content.hero.cta && (
          <div
            class:list={["mt-2 flex flex-wrap items-center", narrowActionLayout]}
            style="gap: 16px 24px"
          >
            <a
              href={content.hero.cta.href}
              style="background: rgb(245, 196, 0); color: rgb(20, 18, 14); text-decoration: none; font-weight: 600; font-size: 17px; padding: 17px 28px; border-radius: 6px"
            >
              {content.hero.cta.label}
            </a>
            {content.hero.cta.note && (
              <span class="text-[15px]" style="color: rgb(230, 223, 207)">
                {content.hero.cta.note}
              </span>
            )}
          </div>
        )
      }
    </div>
  </div>
  <img
    loading="lazy"
    decoding="async"
    class="sn-burst sn-burst-l"
    src="/assets/star-lines-4dde23efecf3.png"
    alt=""
    aria-hidden="true"
  />
  <img
    loading="lazy"
    decoding="async"
    class="sn-burst sn-burst-r"
    src="/assets/star-lines-4dde23efecf3.png"
    alt=""
    aria-hidden="true"
  />
</section>

<section style="padding: 104px 32px">
  <div class="max-w-[1160px] mx-auto my-0 flex flex-col gap-[32px]">
    <h2
      class="m-0 [font-family:'Space_Grotesk',system-ui,sans-serif] font-semibold text-[36px] leading-[1.1] tracking-[-0.02em]"
      >Time is precious. If this isn't you, we aren't for you.</h2
    >
    <div
      class="sn-home-audiences grid gap-5 max-[640px]:[&>a]:min-h-0 max-[640px]:[&>a]:p-[clamp(20px,5vw,28px)]"
      style="grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr))"
    >
      <a
        href="/seed-founders"
        style="--audience-color: #4DA6F0; color: #14120E; border-radius: 10px"
      >
        <svg
          class="block"
          aria-hidden="true"
          width="56"
          height="56"
          viewBox="0 0 24 24"
          fill="none"
          stroke="#14120E"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><defs
            ><linearGradient
              id="snSeedGrad"
              x1="7"
              y1="17"
              x2="17"
              y2="7"
              gradientUnits="userSpaceOnUse"
              ><stop offset="0.06" stop-color="#FF3FA4"></stop><stop
                offset="0.22"
                stop-color="#B44DFF"></stop><stop
                offset="0.38"
                stop-color="#1E90FF"></stop><stop
                offset="0.52"
                stop-color="#19E3E3"></stop><stop
                offset="0.7"
                stop-color="#FFD60A"></stop></linearGradient
            ></defs
          ><path
            d="M16.800 7.200l1.500-1.500M7.200 7.200l-1.500-1.500M7.200 16.800l-1.500 1.500M16.800 16.800l1.500 1.500"
            stroke="#14120E"
            stroke-width="1.800"></path><path
            d="M12 2.500Q14.200 9.800 21.500 12Q14.200 14.200 12 21.500Q9.800 14.200 2.500 12Q9.800 9.800 12 2.500z"
            stroke="#14120E"
            stroke-width="1.800"
            fill="#14120E"></path><path
            d="M16.800 7.200l1.500-1.500M7.200 7.200l-1.500-1.500M7.200 16.800l-1.500 1.500M16.800 16.800l1.500 1.500"
            stroke="#FFD60A"
            stroke-width="1.100"></path><path
            d="M12 2.500Q14.200 9.800 21.500 12Q14.200 14.200 12 21.500Q9.800 14.200 2.500 12Q9.800 9.800 12 2.500z"
            stroke="#FFD60A"
            stroke-width="1.100"
            fill="#FFFFFF"></path><path
            d="M12 5.800Q13.500 10.500 18.200 12Q13.500 13.500 12 18.200Q10.500 13.500 5.800 12Q10.500 10.500 12 5.800z"
            stroke="none"
            fill="url(#snSeedGrad)"></path></svg
        >
        <span
          class="text-[13px] font-semibold tracking-[0.08em] uppercase text-[#14120E]"
          >01 Seed</span
        >
        <span
          class="[font-family:'Space_Grotesk',system-ui,sans-serif] font-semibold text-[28px] leading-[1.15] tracking-[-0.02em]"
          >Seed founders</span
        >
        <span class="text-[16px] text-[#14120E] grow"
          >You're raising a seed and your lead is in. We add $250K to $500K at
          their terms, and exited founders come with us to help you achieve
          critical milestones.</span
        >
        <span class="sn-audience-button font-semibold text-[16px]">I am a top startup →</span>
      </a>
      <a
        href="/growth-stage-ceos"
        style="--audience-color: #5ED4DE; color: #14120E; border-radius: 10px"
      >
        <svg
          class="block"
          aria-hidden="true"
          width="56"
          height="56"
          viewBox="0 0 24 24"
          fill="none"
          stroke="#14120E"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><defs
            ><linearGradient
              id="snGrowthGrad"
              x1="11.5"
              y1="12.2"
              x2="19.8"
              y2="4.2"
              gradientUnits="userSpaceOnUse"
              ><stop offset="0.06" stop-color="#FF3FA4"></stop><stop
                offset="0.22"
                stop-color="#B44DFF"></stop><stop
                offset="0.38"
                stop-color="#1E90FF"></stop><stop
                offset="0.52"
                stop-color="#19E3E3"></stop><stop
                offset="0.7"
                stop-color="#FFD60A"></stop></linearGradient
            ><linearGradient
              id="snGrowthTrail"
              x1="2.8"
              y1="21"
              x2="12.8"
              y2="9.3"
              gradientUnits="userSpaceOnUse"
              ><stop offset="0" stop-color="#FF3FA4"></stop><stop
                offset="0.2"
                stop-color="#B44DFF"></stop><stop
                offset="0.38"
                stop-color="#1E90FF"></stop><stop
                offset="0.54"
                stop-color="#19E3E3"></stop><stop
                offset="0.74"
                stop-color="#FFD60A"></stop></linearGradient
            ></defs
          ><g stroke="#14120E" stroke-width="4.100"
            ><path d="M2.800 14.600c2.600-2.600 5.300-4.300 8.200-5.300"
            ></path><path d="M3.200 21c2.200-3.700 5-6.400 8.400-8.500"
            ></path><path d="M8.800 20c1.100-1.800 2.400-3.300 4-4.600"
            ></path></g
          ><g stroke="#FFD60A" stroke-width="3.400"
            ><path d="M2.800 14.600c2.600-2.600 5.300-4.300 8.200-5.300"
            ></path><path d="M3.200 21c2.200-3.700 5-6.400 8.400-8.500"
            ></path><path d="M8.800 20c1.100-1.800 2.400-3.300 4-4.600"
            ></path></g
          ><g stroke="#FFFFFF" stroke-width="2.200"
            ><path d="M2.800 14.600c2.600-2.600 5.300-4.300 8.200-5.300"
            ></path><path d="M3.200 21c2.200-3.700 5-6.400 8.400-8.500"
            ></path><path d="M8.800 20c1.100-1.800 2.400-3.300 4-4.600"
            ></path></g
          ><g stroke="url(#snGrowthTrail)" stroke-width="1.300"
            ><path d="M2.800 14.600c2.600-2.600 5.300-4.300 8.200-5.300"
            ></path><path d="M3.200 21c2.200-3.700 5-6.400 8.400-8.500"
            ></path><path d="M8.800 20c1.100-1.800 2.400-3.300 4-4.600"
            ></path></g
          ><path
            d="M15.60 2.60L17.43 6.08L21.31 6.75L18.57 9.56L19.13 13.45L15.60 11.72L12.07 13.45L12.63 9.56L9.89 6.75L13.77 6.08z"
            stroke="#14120E"
            stroke-width="4.300"
            fill="#14120E"></path><path
            d="M15.60 2.60L17.43 6.08L21.31 6.75L18.57 9.56L19.13 13.45L15.60 11.72L12.07 13.45L12.63 9.56L9.89 6.75L13.77 6.08z"
            stroke="#FFD60A"
            stroke-width="3.600"
            fill="#FFD60A"></path><path
            d="M15.60 2.60L17.43 6.08L21.31 6.75L18.57 9.56L19.13 13.45L15.60 11.72L12.07 13.45L12.63 9.56L9.89 6.75L13.77 6.08z"
            stroke="#FFFFFF"
            stroke-width="2.400"
            fill="#FFFFFF"></path><path
            d="M15.60 4.10L16.98 6.71L19.88 7.21L17.83 9.32L18.25 12.24L15.60 10.94L12.95 12.24L13.37 9.32L11.32 7.21L14.22 6.71z"
            stroke="url(#snGrowthGrad)"
            stroke-width="0.800"
            fill="url(#snGrowthGrad)"></path></svg
        >
        <span
          class="text-[13px] font-semibold tracking-[0.08em] uppercase text-[#14120E]"
          >02 Growth</span
        >
        <span
          class="[font-family:'Space_Grotesk',system-ui,sans-serif] font-semibold text-[28px] leading-[1.15] tracking-[-0.02em]"
          >Growth-stage CEOs</span
        >
        <span class="text-[16px] text-[#14120E] grow"
          >You're scaling and the decisions keep getting more expensive. We'll
          match you with an exited founder who has solved your biggest challenge
          today.</span
        >
        <span class="sn-audience-button font-semibold text-[16px]">I am a growth-stage CEO →</span>
      </a>
      <a
        href="/exited-founders"
        style="--audience-color: #F2C94C; color: #14120E; border-radius: 10px"
      >
        <img
          class="w-[58px] h-[56px] block"
          loading="lazy"
          decoding="async"
          src="/assets/supernova-star-dfb348239f2e.png"
          alt=""
          aria-hidden="true"
        />
        <span
          class="text-[13px] font-semibold tracking-[0.08em] uppercase text-[#14120E]"
          >03 Exited</span
        >
        <span
          class="[font-family:'Space_Grotesk',system-ui,sans-serif] font-semibold text-[28px] leading-[1.15] tracking-[-0.02em]"
          >Exited founders</span
        >
        <span class="text-[16px] text-[#14120E] grow"
          >You built it, scaled it and sold it. Come help the next founder who
          needs you in their corner. Supernova is where exited founders build
          together.</span
        >
        <span class="sn-audience-button font-semibold text-[16px]">I am an exited founder →</span>
      </a>
    </div>
  </div>
</section>

<section style="background: #14120E; color: #FAF5EA; padding: 0 32px">
  <div
    class="mx-auto grid max-w-[1160px] grid-cols-[repeat(auto-fit,minmax(min(160px,100%),1fr))] gap-x-6 gap-y-9 py-16
      [&>div]:flex [&>div]:min-w-0 [&>div]:flex-col [&>div]:gap-1.5
      max-[640px]:grid-cols-2 max-[640px]:gap-x-3 max-[640px]:gap-y-6 max-[640px]:py-[38px]"
  >
    <div><span
        class="[font-family:'Space_Grotesk',system-ui,sans-serif] font-semibold text-[clamp(28px,6vw,40px)] leading-[1] text-[#F0C84B]"
        ><span class="sr-only">250+</span><span data-stat-count aria-hidden="true">250+</span></span
      ><span class="text-[14px] text-[#CFC7B6]">exited founders</span></div
    >
    <div><span
        class="[font-family:'Space_Grotesk',system-ui,sans-serif] font-semibold text-[clamp(28px,6vw,40px)] leading-[1] text-[#F0C84B]"
        ><span class="sr-only">33</span><span data-stat-count aria-hidden="true">33</span></span
      ><span class="text-[14px] text-[#CFC7B6]">portfolio companies</span></div
    >
    <div><span
        class="[font-family:'Space_Grotesk',system-ui,sans-serif] font-semibold text-[clamp(28px,6vw,40px)] leading-[1] text-[#F0C84B]"><span class="sr-only">$500K</span><span data-stat-count aria-hidden="true">$500K</span></span
      ><span class="text-[14px]" style="color: rgb(207, 199, 182)"
        >seed round check size</span
      ></div
    >
    <div><span
        class="[font-family:'Space_Grotesk',system-ui,sans-serif] font-semibold text-[clamp(28px,6vw,40px)] leading-[1] text-[#F0C84B]"
        ><span class="sr-only">92</span><span data-stat-count aria-hidden="true">92</span></span
      ><span class="text-[14px] text-[#CFC7B6]">NPS from founders</span></div
    >
    <div><span
        class="[font-family:'Space_Grotesk',system-ui,sans-serif] font-semibold text-[clamp(28px,6vw,40px)] leading-[1] text-[#F0C84B]"
        ><span class="sr-only">$100B+</span><span data-stat-count aria-hidden="true">$100B+</span></span
      ><span class="text-[14px] text-[#CFC7B6]">collective exit value</span
      ></div
    >
  </div>
</section>

<section style="padding: 112px 32px">
  <div
    class="max-w-[1160px] mx-auto my-0 grid items-start"
    style="grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr)); gap: 32px 72px"
  >
    <div class="flex flex-col gap-[20px]">
      <span
        class="[font-family:'IBM_Plex_Mono',ui-monospace,Menlo,monospace] text-[12px] tracking-[0.12em] uppercase text-[#5E584C]"
        >Why exited founders</span
      >
      <h2
        class="m-0 [font-family:'Space_Grotesk',system-ui,sans-serif] font-semibold text-[clamp(32px,3.8vw,46px)] leading-[1.1] tracking-[-0.02em]"
        >Most startup advice comes from people who haven't lived the
        consequences. <span class="underline decoration-gold decoration-[3px] underline-offset-[6px]">Exited founders have.</span></h2
      >
    </div>
    <div class="flex flex-col gap-[20px] min-[977px]:pt-[34px]">
      <p class="m-0 text-[20px] text-[#3A362D]"
        >They've been through hypergrowth, near-death quarters, board pressure
        and exits.</p
      >
      <p
        style="margin: 0; font-family: 'Space Grotesk', system-ui, sans-serif; font-weight: 600; font-size: 24px; line-height: 1.25; color: #14120E; padding-top: 20px; border-top: 2px dotted #B9B09A"
        >They've made the mistakes and survived them. That's why they're the
        most trusted partners you can have beside you.</p
      >
      <p class="m-0 text-[20px] text-[#3A362D]"
        >Supernova gives founders access to that rarest resource: lived
        experience when it matters most.<br /><br /><span class="text-[19px]"
          >We invest, embed and activate to hit your critical milestones faster. <br
          /><br />We don't sit on the sidelines. We get in the game with you.</span
        ></p
      >
    </div>
  </div>
</section>

<section class="sn-impact">
  <div
    class="sn-slide sn-slide-1"
    aria-hidden="true"
    style="background-image: url(/assets/allgood-hires-0534a08acb7f.jpg)"></div>
  <div
    class="sn-slide"
    aria-hidden="true"
    style="background-image: url(/assets/founders-group-ce8d035494c8.jpg); animation-delay: 8s"
  ></div>
  <div
    class="sn-slide"
    aria-hidden="true"
    style="background-image: url(/assets/dublin-stage-clean-7802af699646.jpg); animation-delay: 16s"
  ></div>
  <div
    class="sn-slide"
    aria-hidden="true"
    style="background-image: url(/assets/thrive-crowd-c23b88e47f75.jpg); animation-delay: 24s"
  ></div>
  <div
    class="relative z-[1] mx-auto box-border flex max-w-[760px] flex-col items-center justify-center gap-6 px-6
      pt-[clamp(72px,10vw,120px)] pb-8 text-center min-[1201px]:min-h-[780px] min-[1201px]:px-8
      min-[1201px]:py-[200px]"
  >
    <h2
      class="m-0 [font-family:'Space_Grotesk',system-ui,sans-serif] font-semibold text-[clamp(40px,5.4vw,72px)] leading-[1.02] tracking-[-0.03em] text-[#f5c400]"
      >How can we help?</h2
    >
    <p class="m-0 text-[20px] leading-[1.5] text-[#E6DFCF]"
      ><span class="block">Bring the decision you haven't made before.</span>
      <span class="block">We'll bring the exited founders who already have.</span></p
    >
    <a
      href="https://nova.1supernova.com/#/apply-with-ai"
      style="margin-top: 8px; background: #F5C400; color: #14120E; text-decoration: none; font-weight: 600; font-size: 17px; padding: 17px 28px; border-radius: 6px"
      >Talk to NOVA AI →</a
    >
    <a
      class="text-[#FAF5EA] text-[16px] font-medium"
      href="https://nova.1supernova.com/#/apply-with-ai"
      style="text-decoration: underline; text-underline-offset: 4px; padding: 8px 0"
      >Apply to Supernova</a
    >
  </div>
  <div class="sn-float max-[1200px]:relative max-[1200px]:mx-auto max-[1200px]:box-border max-[1200px]:flex
    max-[1200px]:max-w-[940px] max-[1200px]:flex-wrap max-[1200px]:justify-center max-[1200px]:gap-2
    max-[1200px]:px-5 max-[1200px]:pb-[clamp(48px,7vw,80px)] max-[1200px]:[&>.sn-pill]:static
    max-[1200px]:[&>.sn-pill]:box-border max-[1200px]:[&>.sn-pill]:max-w-full
    max-[1200px]:[&>.sn-pill]:text-center max-[1200px]:[&>.sn-pill]:text-sm
    max-[1200px]:[&>.sn-pill]:whitespace-normal max-[1200px]:[&>.sn-pill]:[animation:none]
    max-[640px]:px-0" aria-label="Where exited founders help"
    ><span class="sn-pill" style="left: 5%; top: 13%"
      >Raising your next round</span
    ><span class="sn-pill" style="left: 29%; top: 7%"
      >Building your executive team</span
    ><span class="sn-pill" style="left: 64%; top: 10%"
      >Preparing for an exit</span
    ><span class="sn-pill" style="right: 3%; top: 21%"
      >Walking into the boardroom</span
    ><span class="sn-pill" style="left: 16%; top: 25%">Pivoting</span><span
      class="sn-pill"
      style="left: 8%; top: 40%">Subscription revenue</span
    ><span class="sn-pill" style="right: 4%; top: 41%"
      >Enterprise contracts</span
    ><span class="sn-pill" style="left: 3%; top: 59%"
      >Your first sales leader</span
    ><span class="sn-pill" style="right: 3%; top: 60%">Regulatory path</span
    ><span class="sn-pill" style="left: 11%; top: 77%"
      >Investor introductions</span
    ><span class="sn-pill" style="left: 74%; top: 78%">Growing as CEO</span
    ><span class="sn-pill" style="left: 30%; top: 88%"
      >Scaling after a big raise</span
    ><span class="sn-pill" style="left: 56%; top: 89%"
      >Product and engineering</span
    ><span class="sn-pill" style="right: 5%; top: 86%">People</span><span
      class="sn-pill"
      style="left: 47%; top: 17%">AI transformation</span
    ><span class="sn-pill" style="left: 44%; top: 77%">Distribution</span></div
  >
</section>

<section
  style="position: relative; overflow: hidden; background: #FFFFFF; border-top: 1px solid #E3DCCB; border-bottom: 1px solid #E3DCCB; padding: 112px 32px"
>
  <img
    class="absolute left-0 h-auto pointer-events-none top-1/2 w-[min(34vw,440px)] -translate-x-[38%] -translate-y-1/2"
    loading="lazy"
    decoding="async"
    src="/assets/ring-lines-26c73d2f4368.png"
    alt=""
    aria-hidden="true"
  />
  <figure
    class="relative max-w-[940px] mx-auto my-0 flex flex-col items-center text-center gap-[28px]"
  >
    <span
      class="[font-family:'Space_Grotesk',system-ui,sans-serif] font-semibold text-[96px] leading-[0.6] text-[#F5C400] h-[44px]"
      aria-hidden="true">“</span
    >
    <blockquote
      class="m-0 [font-family:'Space_Grotesk',system-ui,sans-serif] font-semibold text-[clamp(28px,3.8vw,48px)] leading-[1.12] tracking-[-0.02em] text-balance"
      >They advise me. I advise others. That's the Supernova effect! When exited
      founders team up results happen faster.</blockquote
    >
    <figcaption
      class="flex flex-col gap-[6px] text-[13px] tracking-[0.12em] uppercase text-[#5E584C]"
      ><span class="font-semibold text-[#14120E]">Ben Lamm</span><span
        >CEO and Co-founder, Colossal. 6x exited founder</span
      ></figcaption
    >
  </figure>
</section>

<section style="padding: 136px 32px 128px">
  <div class="max-w-[1160px] mx-auto my-0 flex flex-col gap-[clamp(2rem,6vw,4.5rem)]">
    <div
      class="grid"
      style="grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr)); gap: 24px 64px; align-items: end"
    >
      <div class="flex flex-col gap-[22px]"
        ><span
          class="[font-family:'IBM_Plex_Mono',ui-monospace,Menlo,monospace] text-[12px] tracking-[0.12em] uppercase text-[#5E584C]"
          >Portfolio</span
        ><h2
          class="m-0 [font-family:'Space_Grotesk',system-ui,sans-serif] font-semibold text-[clamp(44px,6.4vw,88px)] leading-[0.96] tracking-[-0.045em]"
          >Companies we've backed.</h2
        ></div
      >
      <p
        style="margin: 0; font-size: 19px; line-height: 1.5; color: #3A362D; justify-self: end"
