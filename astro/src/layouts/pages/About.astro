<script is:inline>
  (function () {
    var self = { _cv: document.querySelector("[data-globe]") };
    var base = "https://1supernovafund.com/img/";
    var sprite = new Image();
    sprite.src = "/assets/faces-sprite-766a6ceacd75.jpg";
    var earth = new Image();
    earth.src = base + "earth.webp";
    var star = new Image();
    star.src = "/assets/star-lines-4dde23efecf3.png";
    var N = 30;
    var t0 = performance.now();
    function ease(x) {
      return x < 0 ? 0 : x > 1 ? 1 : x * x * (3 - 2 * x);
    }
    function draw(now) {
      self._raf = requestAnimationFrame(draw);
      var c = self._cv;
      if (!c) {
        return;
      }
      var dpr = Math.min(2, window.devicePixelRatio || 1);
      var W = Math.round(c.clientWidth * dpr),
        H = Math.round(c.clientHeight * dpr);
      if (!W || !H) {
        return;
      }
      if (c.width !== W || c.height !== H) {
        c.width = W;
        c.height = H;
      }
      var ctx = c.getContext("2d");
      var t = (now - t0) / 1000,
        cyc = t % 12;
      var k = ease(cyc < 1.5 ? 0 : (cyc - 1.5) / 2.5);
      if (cyc > 9) {
        k = ease(1 - (cyc - 9) / 2);
      }
      if (cyc > 11) {
        k = 0;
      }
      ctx.clearRect(0, 0, W, H);
      var cx = W / 2,
        cy = H / 2,
        R = Math.min(W, H) * 0.4,
        ER = Math.max(1, R - 16 * dpr);
      ctx.save();
      ctx.beginPath();
      ctx.arc(cx, cy, ER * 1.04, 0, 6.2832);
      ctx.clip();
      if (earth.complete && earth.naturalWidth) {
        var sc = ER / (earth.naturalWidth * 0.44),
          ew = earth.naturalWidth * sc;
        ctx.drawImage(earth, cx - ew / 2, cy - ew / 2, ew, ew);
      } else {
        var g0 = ctx.createRadialGradient(
          cx - ER * 0.3,
          cy - ER * 0.35,
          ER * 0.1,
          cx,
          cy,
          ER * 1.05,
        );
        g0.addColorStop(0, "#6FB7F2");
        g0.addColorStop(0.6, "#2B6CB8");
        g0.addColorStop(1, "#123A6B");
        ctx.fillStyle = g0;
        ctx.fillRect(cx - ER * 1.1, cy - ER * 1.1, ER * 2.2, ER * 2.2);
      }
      ctx.restore();
      var halo = ctx.createRadialGradient(cx, cy, ER * 0.98, cx, cy, ER * 1.18);
      halo.addColorStop(0, "rgba(90,180,255,.22)");
      halo.addColorStop(1, "rgba(90,180,255,0)");
      ctx.fillStyle = halo;
      ctx.beginPath();
      ctx.arc(cx, cy, ER * 1.18, 0, 6.2832);
      ctx.fill();
      if (star.complete && star.naturalWidth) {
        var ms = Math.min(W, H) * (0.4 + 0.08 * k);
        ctx.save();
        ctx.globalAlpha = 0.1 + 0.18 * k;
        ctx.translate(cx, cy);
        ctx.rotate(t * 0.05);
        ctx.drawImage(star, -ms, -ms, ms * 2, ms * 2);
        ctx.restore();
      }
      var CO = [{ x: cx, y: cy }];
      for (var a = 0; a < 5; a++) {
        var an = -Math.PI / 2 + (a * 2 * Math.PI) / 5;
        CO.push({
          x: cx + Math.cos(an) * R * 0.62,
          y: cy + Math.sin(an) * R * 0.62,
        });
      }
      CO.forEach(function (co) {
        if (k > 0.05) {
          ctx.beginPath();
          ctx.arc(co.x, co.y, 54 * dpr, 0, 6.2832);
          ctx.strokeStyle = "rgba(184,134,11," + 0.35 * k + ")";
          ctx.lineWidth = dpr;
          ctx.stroke();
        }
        var g = ctx.createRadialGradient(co.x, co.y, 0, co.x, co.y, 48 * dpr);
        g.addColorStop(0, "rgba(246,195,74," + (0.15 + 0.45 * k) + ")");
        g.addColorStop(1, "rgba(246,195,74,0)");
        ctx.fillStyle = g;
        ctx.beginPath();
        ctx.arc(co.x, co.y, 48 * dpr, 0, 6.2832);
        ctx.fill();
        ctx.fillStyle = "#F5B82E";
        ctx.beginPath();
        ctx.arc(co.x, co.y, (5 + 3 * k) * dpr, 0, 6.2832);
        ctx.fill();
        ctx.strokeStyle = "#fff";
        ctx.lineWidth = 2 * dpr;
        ctx.stroke();
      });
      for (var j = 0; j < N; j++) {
        var co2 = CO[j % 6],
          kk = Math.floor(j / 6);
        var ang = (kk / 5) * 2 * Math.PI + t * 0.15 + (j % 6) * 1.3;
        var tx = co2.x + Math.cos(ang) * 36 * dpr,
          ty = co2.y + Math.sin(ang) * 36 * dpr;
        var oa = (j / N) * 2 * Math.PI + t * 0.04;
        var ox = cx + Math.cos(oa) * R,
          oy = cy + Math.sin(oa) * R;
        var fx = ox + (tx - ox) * k,
          fy = oy + (ty - oy) * k,
          fr = 17 * dpr,
          fi = j % 16,
          sq = sprite.naturalWidth / 4;
        ctx.save();
        ctx.beginPath();
        ctx.arc(fx, fy, fr, 0, 6.2832);
        ctx.closePath();
        ctx.clip();
        if (sprite.complete && sprite.naturalWidth) {
          ctx.drawImage(
            sprite,
            (fi % 4) * sq,
            Math.floor(fi / 4) * sq,
            sq,
            sq,
            fx - fr,
            fy - fr,
            fr * 2,
            fr * 2,
          );
        } else {
          ctx.fillStyle = "#F1D9A6";
          ctx.fillRect(fx - fr, fy - fr, fr * 2, fr * 2);
        }
        ctx.restore();
        ctx.beginPath();
        ctx.arc(fx, fy, fr, 0, 6.2832);
        ctx.strokeStyle = "#fff";
        ctx.lineWidth = 2 * dpr;
        ctx.stroke();
      }
    }
    self._raf = requestAnimationFrame(draw);
    var v = document.querySelector("[data-hero-video]");
    if (v) {
      v.muted = true;
      v.loop = true;
      v.playsInline = true;
      var p = v.play();
      if (p && p.catch) {
        p.catch(function () {
          return null;
        });
      }
    }
  })();
</script>
