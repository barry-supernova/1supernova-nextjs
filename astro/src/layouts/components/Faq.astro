---
import type { CollectionEntry } from "astro:content";

interface Props {
  items: CollectionEntry<"pages">["data"]["faq"];
}

const { items } = Astro.props;
---

{items.map(({ question, answer }) => (
  <details class="sn-q rounded-[14px] border border-[#e3dccb] bg-white px-4 sm:px-6">
    <summary class="list-item cursor-pointer py-4 font-['Space_Grotesk',system-ui,sans-serif] text-lg leading-[1.3] font-semibold sm:py-[22px] sm:text-xl">
      {question}
    </summary>
    <p class="m-0 max-w-[640px] pb-5 text-base text-[#3a362d] sm:pb-6 sm:text-[17px]">{answer}</p>
  </details>
))}
