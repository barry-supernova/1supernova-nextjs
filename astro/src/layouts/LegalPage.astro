---
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";

interface Props {
  title: string;
  description: string;
  path: string;
}

const { title, description, path } = Astro.props;
const page = {
  title: `${title} | Supernova`,
  description,
  image: config.site.favicon,
  hero: { eyebrow: "", title, description: "" },
  faqTitle: "",
  faq: [],
};
---

<Base content={page} {path}>
  <article class="mx-auto max-w-3xl px-[clamp(1rem,5vw,2rem)] py-[clamp(3rem,7vw,6rem)]">
    <h1 class="m-0 mb-8 font-display text-[clamp(2.25rem,5vw,3.75rem)] leading-tight font-semibold">{title}</h1>
    <div class="text-base leading-relaxed [overflow-wrap:anywhere] [&_a]:underline [&_h3]:mt-8 [&_h3]:mb-3 [&_h3]:font-display [&_h3]:text-xl [&_h3]:font-semibold [&_h4]:mt-5 [&_h4]:mb-2 [&_h4]:font-semibold [&_ol]:ps-6 [&_ul]:ps-6">
      <slot />
    </div>
  </article>
</Base>
