---
import Base from "@/layouts/Base.astro";
import config from "@/config/config.json";

const content = {
  title: "Page not found | Supernova",
  description: "The page you requested could not be found.",
  image: config.site.favicon,
  hero: { eyebrow: "", title: "", description: "" },
  faqTitle: "",
  faq: [],
};
---

<Base {content} path="/404">
  <section class="mx-auto max-w-290 px-8 py-24">
    <h1 class="m-0 font-display text-5xl">Page not found</h1>
    <p><a href="/" class="text-ink">Back to the home page</a></p>
  </section>
</Base>
